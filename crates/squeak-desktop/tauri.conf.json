{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "squeak",
  "version": "0.1.0",
  "identifier": "com.squeak.app",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "squeak",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32.png", "icons/128.png", "icons/icon.png"]
  }
}
